# ===========================================================================
# ANJANEYA - environment template
# ===========================================================================
# Copy this file to `.env` and fill in real values.  `.env` is git-ignored.
# NEVER commit real credentials, and never hard-code them in YAML or Python:
# the config files only reference the environment variable NAMES.
#
# The file is loaded automatically by every entry point (core/env.py) from the
# directory above `config/`.  Rules:
#   * a real environment variable always wins over a `.env` value;
#   * blank values are ignored (`ZERODHA_PASSWORD=` == unset);
#   * nothing here is ever printed or logged - only the variable NAMES are.
# To disable loading for one shell:  ANJANEYA_SKIP_DOTENV=1
# ===========================================================================

# ---------------------------------------------------------------------------
# Zerodha Kite Connect credentials
# ---------------------------------------------------------------------------
# From https://developers.kite.trade/ (Kite Connect app -> API key/secret).
ZERODHA_API_KEY=your_api_key_here
ZERODHA_API_SECRET=your_api_secret_here

# Zerodha login user id, e.g. AB1234
ZERODHA_USER_ID=your_user_id_here

# Zerodha account password - ONLY required for fully automated TOTP login.
# Leave empty and use `--request-token <token>` (manual browser login) if you
# do not want the password on disk.
ZERODHA_PASSWORD=

# Base32 TOTP secret (the string behind the QR code in Kite's 2FA setup).
ZERODHA_TOTP_KEY=your_totp_secret_here
#
# UNATTENDED RUNS NEED ALL THREE: ZERODHA_USER_ID + ZERODHA_PASSWORD +
# ZERODHA_TOTP_KEY are what let the scheduled morning task
# (scripts/run_morning.py via scripts/schedule_tasks.ps1) log in without a human.
# Without them, `python scripts/doctor.py` reports "TOTP login is unavailable"
# and you keep using the interactive route instead:
#   * python scripts/login_and_start.py          (catches the request_token in a browser)
#   * python scripts/daily_login.py --request-token <token>
# A real environment variable always wins, and a blank value is treated as unset.

# The redirect URL registered for your Kite Connect app (developers.kite.trade).
# Set it to a loopback address with an explicit port (e.g. http://127.0.0.1:8444/)
# AND register exactly that URL in the app console: `python scripts/login_and_start.py`
# then catches the request_token itself, so the morning login needs no copy/paste.
# Blank keeps the manual route (read the request_token out of the redirect URL).
ZERODHA_REDIRECT_URL=

# ---------------------------------------------------------------------------
# ANJANEYA runtime overrides (optional - sensible defaults live in
# config/settings.yaml; these only need to be set to override them)
# ---------------------------------------------------------------------------
# Root directory for all captured/derived data. Relative paths resolve
# against the repository root.
ANJANEYA_DATA_ROOT=./data

# Local analytical DuckDB database file.
ANJANEYA_DB_PATH=./db/anjaneeya.duckdb

# Log level: TRACE | DEBUG | INFO | WARNING | ERROR
ANJANEYA_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Test / tooling switches
# ---------------------------------------------------------------------------
# Set to 1 to enable tests marked `live` (they hit the real Zerodha API and
# therefore need valid credentials above). Default: disabled.
ANJANEYA_RUN_LIVE=0
